#include <Adafruit_GFX.h>
#include "Arduino_ST7789.h"
#include <SPI.h>
#include <WiFi.h>

#define TFT_MOSI 23
#define TFT_SCLK 18
#define TFT_DC   2
#define TFT_RST  4
#define TFT_CS   0

Arduino_ST7789 tft = Arduino_ST7789(TFT_DC, TFT_RST, TFT_MOSI, TFT_SCLK, TFT_CS);

void setup() {
  Serial.begin(115200);
  delay(200);

  // Pornire ecran
  tft.init(240, 240);
  tft.setRotation(-1);
  tft.fillScreen(WHITE);

  tft.setTextColor(BLACK);
  tft.setTextSize(2);
  tft.setCursor(20, 20);
  tft.println("Scanare WiFi...");

  // Modul WiFi STATION
  WiFi.mode(WIFI_MODE_STA);
  WiFi.disconnect();
  delay(200);
}

void loop() {

  Serial.println("\nScanare retele...");
  int n = WiFi.scanNetworks();

  if (n <= 0) {
    Serial.println("Nu s-au gasit retele.");
    tft.fillScreen(WHITE);
    tft.setCursor(20, 20);
    tft.println("Nicio retea gasita");
  } 
  else 
  {
    Serial.printf("%d retele gasite:\n", n);

    // Cautam reteaua cu RSSI maxim (cel mai puternic semnal)
    int bestIndex = 0;
    int bestRSSI = -999;

    for (int i = 0; i < n; i++) {
      int rssi = WiFi.RSSI(i);
      String ssid = WiFi.SSID(i);

      Serial.printf("%d. %s  RSSI:%d\n", i+1, ssid.c_str(), rssi);

      if (rssi > bestRSSI) {
        bestRSSI = rssi;
        bestIndex = i;
      }
    }

    // Afisare cea mai buna retea
    String bestSSID = WiFi.SSID(bestIndex);

    Serial.println("-------------------------");
    Serial.printf("Cea mai puternica retea: %s (%d dBm)\n",
                  bestSSID.c_str(), bestRSSI);
    Serial.println("-------------------------");

    // Afisare pe ecran TFT
    tft.fillScreen(WHITE);
    tft.setTextColor(BLACK);
    tft.setTextSize(2);
    tft.setCursor(20, 40);
    tft.println("Cea mai puternica:");
    
    tft.setTextColor(RED);
    tft.setCursor(20, 80);
    tft.println(bestSSID);

    tft.setTextColor(BLUE);
    tft.setCursor(20, 120);
    tft.printf("RSSI: %d dBm", bestRSSI);
  }

  delay(10000); // Scanare la fiecare 10 secunde
}
